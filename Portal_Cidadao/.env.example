# Copie este arquivo para ".env" e preencha com os seus dados reais.
# O arquivo .env NUNCA deve ser commitado no Git (contém senha).

SECRET_KEY=troque-por-uma-chave-aleatoria-depois

# Formato: postgresql://usuario:senha@host:porta/nome_do_banco
DATABASE_URL=postgresql://postgres:sua_senha_aqui@localhost:5432/cidadao

# Envio de e-mail (opcional). Se deixar em branco, o sistema simplesmente
# não envia e-mail de confirmação — o resto do projeto funciona normal.
#
# Exemplo usando Gmail: você precisa gerar uma "senha de app" em
# https://myaccount.google.com/apppasswords (não é a senha normal da
# sua conta Google — o Gmail exige isso para acesso de aplicativos).
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=seu_email@gmail.com
MAIL_PASSWORD=sua_senha_de_app_de_16_caracteres
MAIL_DEFAULT_SENDER=seu_email@gmail.com
